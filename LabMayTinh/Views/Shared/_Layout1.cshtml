<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - LabMayTinh</title>
    <!-- Bootstrap 5 CSS & Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* Logo LA 3D Dập Nổi */
        .logo-3d-box {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .logo-badge {
            background: linear-gradient(145deg, #ffb5a7, #fcd5ce);
            color: #2b2d42;
            font-weight: 900;
            font-size: 1.4rem;
            padding: 2px 10px;
            border-radius: 10px;
            text-shadow: 1px 1px 0px #ffffff, 2px 2px 3px rgba(0,0,0,0.2);
            box-shadow: inset 1px 1px 2px rgba(255,255,255,0.8), 3px 3px 6px rgba(0,0,0,0.15);
            transition: all 0.3s ease;
        }

        .logo-text {
            font-weight: 800;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
            color: #ffffff;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
        }

        .nav-link-custom {
            color: rgba(255,255,255,0.8) !important;
            font-weight: 500;
            transition: all 0.2s;
            cursor: pointer;
        }
        .nav-link-custom:hover, .nav-link-custom.active {
            color: #ffffff !important;
            font-weight: 700;
        }

        /* Avatar Modal */
        .avatar-img {
            width: 110px;
            height: 110px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #ffb5a7;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        /* Footer Tùy Biến Chuyên Nghiệp */
        .custom-footer {
            background: rgba(0, 0, 0, 0.05);
            backdrop-filter: blur(8px);
            border-top: 1px solid rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        body.dark-mode .custom-footer {
            background: rgba(15, 23, 42, 0.9);
            border-top: 1px solid rgba(148, 163, 184, 0.2);
            color: #f8fafc !important;
        }

        body.dark-mode .custom-footer a {
            color: #38bdf8 !important;
        }

        body.dark-mode .modal-content {
            background-color: #1e293b;
            color: #f8fafc;
            border: 1px solid #334155;
        }

        .social-btn {
            font-size: 1.2rem;
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: transform 0.2s;
        }
        .social-btn:hover {
            transform: translateY(-3px);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3 py-2">
            <div class="container">
                <!-- Logo LA 3D & Name -->
                <a class="logo-3d-box" asp-controller="MayTinh" asp-action="Index">
                    <span class="logo-badge">LA</span>
                    <span class="logo-text">LabMayTinh</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="MayTinh" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="MayTinh" asp-action="GioiThieu">Giới thiệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" data-bs-toggle="modal" data-bs-target="#lienHeModal">Liên hệ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom active" asp-controller="MayTinh" asp-action="Index">Phép tính</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Modal Popup Thông Tin Liên Hệ Cá Nhân -->
    <div class="modal fade" id="lienHeModal" tabindex="-1" aria-labelledby="lienHeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="lienHeModalLabel">📬 Thông Tin Tác Giả</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pt-2 fs-6">
                    <img src="~/images/avatar.jpg" alt="Lê Anh Đại" class="avatar-img mb-3" onerror="this.src='https://via.placeholder.com/110';" />
                    
                    <h4 class="fw-bold mb-1">Lê Anh Đại</h4>
                    <p class="text-muted mb-2">Sinh viên Lớp K26-ĐHSP Tin học</p>
                    <p class="fw-semibold text-primary mb-3">Trường Đại học Hồng Đức</p>

                    <div class="d-flex justify-content-center gap-3 mt-3">
                        <a href="https://www.facebook.com/phannguoi.quyet" target="_blank" class="btn btn-primary social-btn"><i class="bi bi-facebook"></i></a>
                        <a href="https://www.youtube.com/@@thaydai68_vlog" target="_blank" class="btn btn-danger social-btn"><i class="bi bi-youtube"></i></a>
                        <a href="https://github.com/anhdaizatdu" target="_blank" class="btn btn-dark social-btn"><i class="bi bi-github"></i></a>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Chuyên Nghiệp -->
    <footer class="custom-footer mt-auto py-3">
        <div class="container">
            <div class="row gy-2 align-items-center">
                <div class="col-md-7 text-center text-md-start">
                    <span class="fw-bold">&copy; 2026 - Lê Anh Đại | K26-ĐHSP Tin học</span>
                    <span class="d-block d-sm-inline text-muted small ms-sm-2">Đại học Hồng Đức</span>
                </div>
                <div class="col-md-5 text-center text-md-end">
                    <a href="https://www.facebook.com/phannguoi.quyet" target="_blank" class="text-secondary me-3"><i class="bi bi-facebook fs-5"></i></a>
                    <a href="https://www.youtube.com/@@thaydai68_vlog" target="_blank" class="text-secondary me-3"><i class="bi bi-youtube fs-5"></i></a>
                    <a href="https://github.com/anhdaizatdu" target="_blank" class="text-secondary"><i class="bi bi-github fs-5"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>